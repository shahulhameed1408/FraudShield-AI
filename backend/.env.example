# FraudShield AI - Environment Configuration Example
# Copy to .env and adjust values as needed.

# Host and Port configuration
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (comma-separated list of permitted frontend URLs)
# Use * for local development. In production, specify exact domain(s) e.g. https://fraudshield.example.com
ALLOWED_ORIGINS=*

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
